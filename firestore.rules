rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Users: solo el propio usuario puede leer/escribir su perfil
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Motorcycles: solo el dueño puede leer/escribir sus motos
    match /motorcycles/{motoId} {
      allow read, write: if request.auth != null 
        && request.resource.data.userId == request.auth.uid;
      allow read: if request.auth != null 
        && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null 
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null 
        && resource.data.userId == request.auth.uid;
    }
    
    // Diagnostics: solo el dueño puede leer/escribir sus diagnósticos
    match /diagnostics/{diagId} {
      allow read: if request.auth != null 
        && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null 
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null 
        && resource.data.userId == request.auth.uid;
    }
    
    // Tutorials: cualquier usuario autenticado puede leer
    match /tutorials/{tutorialId} {
      allow read: if request.auth != null;
    }
  }
}
